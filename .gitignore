# Python 学习产生的临时文件
__pycache__/
*.pyc
.ipynb_checkpoints/

# 数据分析工具的临时文件
.Rhistory
.DS_Store

# 编辑器临时文件
*.swp
*~

# ===== 密钥 / API Key / 凭据：一律禁止入库 =====

# 环境变量文件（常含密钥）
.env
.env.*
*.env

# 密钥与证书文件
*.pem
*.key
*.p12
*.pfx
*.crt

# 凭据/配置类 JSON
credentials*.json
*credential*.json

# 文件名中包含 api key / secret / token 的常见形式
*apikey*
*api_key*
*api-key*
*apikeys*
*secret_key*
*secret-key*
*access_token*
